---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FlipCardHero from '../../components/flipcard/FlipCardHero.jsx';
import PromptCopyBox from '../../components/PromptCopyBox.astro';
// 提示词全文存为 md 单一事实来源，?raw 读入供一键复制
import promptZh from '../../lib/prompts/flip-card.zh.md?raw';

const usageExample = `import FlipCard from './FlipCard';

<FlipCard
  front={<img src="/landscape.jpg" alt="Wooded landscape" style={{ width: '100%', height: '100%', objectFit: 'cover' }} />}
  back={
    <div style={{ padding: 24 }}>
      <h3>Wooded Landscape</h3>
      <p>17th century · Rijksmuseum</p>
    </div>
  }
  axis="y"
  flipOnClick
  draggable
  dragDistance={0}
  tilt
  tiltMax={12}
  glare
  glareOpacity={0.22}
  hoverScale={1.03}
  perspective={1100}
  stiffness={170}
  damping={20}
  width={300}
  height={400}
  radius={22}
  background="#27272a"
  color="#f5f5f5"
  shadow
  shadowColor="#000000"
  shadowOpacity={0.45}
  onFlipChange={flipped => console.log(flipped)}
/>`;

const props = [
  { name: 'front', type: 'ReactNode', def: 'null', desc: '正面内容。' },
  { name: 'back', type: 'ReactNode', def: 'null', desc: '背面内容。' },
  { name: 'flipped', type: 'boolean', def: '-', desc: '受控状态：true 显示背面。不传则由卡片自己管理状态。' },
  { name: 'defaultFlipped', type: 'boolean', def: 'false', desc: '初始就停在背面。' },
  { name: 'onFlipChange', type: '(flipped: boolean) => void', def: '-', desc: '点击、拖拽、甩动或按键落在另一面上时触发。' },
  { name: 'axis', type: "'y' \\| 'x'", def: "'y'", desc: 'y 让卡片左右翻面、水平方向拖拽；x 让卡片从顶上翻过去、垂直方向拖拽。' },
  { name: 'flipOnClick', type: 'boolean', def: 'true', desc: '按下后没有移动就翻面。' },
  { name: 'draggable', type: 'boolean', def: 'true', desc: '可以用手拖动翻卡。松手时弹回最近的面，并带上甩动的速度。' },
  { name: 'dragDistance', type: 'number', def: '0', desc: '半圈需要的拖拽像素。0 时取卡片宽度（x 轴时取高度）。' },
  { name: 'tilt', type: 'boolean', def: 'true', desc: '悬停时卡片朝光标方向倾斜。' },
  { name: 'tiltMax', type: 'number', def: '12', desc: '最大倾角（度）。' },
  { name: 'glare', type: 'boolean', def: 'true', desc: '跟随光标的柔和光泽。' },
  { name: 'glareOpacity', type: 'number', def: '0.22', desc: '光泽中心点的强度。' },
  { name: 'hoverScale', type: 'number', def: '1.03', desc: '悬停或按住时抬起的缩放。' },
  { name: 'perspective', type: 'number', def: '1100', desc: '观察距离（px），越小越夸张。' },
  { name: 'stiffness', type: 'number', def: '170', desc: '翻面弹簧的刚度。' },
  { name: 'damping', type: 'number', def: '20', desc: '翻面弹簧的阻尼，越低过冲越多。' },
  { name: 'width', type: 'number', def: '300', desc: '卡片宽度（px），上限为父容器宽度。' },
  { name: 'height', type: 'number', def: '400', desc: '卡片高度（px）。' },
  { name: 'radius', type: 'number', def: '22', desc: '圆角半径（px）。' },
  { name: 'background', type: 'string', def: "'#27272a'", desc: '两个面的底色。' },
  { name: 'color', type: 'string', def: "'#f5f5f5'", desc: '两个面的文字颜色。' },
  { name: 'shadow', type: 'boolean', def: 'true', desc: '卡片下方的柔和阴影，翻到侧面时会收窄。' },
  { name: 'shadowColor', type: 'string', def: "'#000000'", desc: '阴影颜色。' },
  { name: 'shadowOpacity', type: 'number', def: '0.45', desc: '阴影强度。' },
  { name: 'disabled', type: 'boolean', def: 'false', desc: '变暗、变平且不可交互。' },
  { name: 'ariaLabel', type: 'string', def: "'Flip card'", desc: '无障碍名称，当前在正面还是背面通过 aria-pressed 播报。' },
  { name: 'className', type: 'string', def: "''", desc: '根元素的额外类名。' },
];
---

<BaseLayout
  title="FlipCard 实时演示 · React Bits 集成提示词 · 每日所学"
  description="React Bits 开源组件 FlipCard 的实时效果演示与集成提示词中文翻译：motion 弹簧驱动的 3D 翻转卡片，点击拖拽甩动翻面，悬停朝光标倾斜带眩光。"
>
  <FlipCardHero client:visible />

  <article class="prose prose-slate dark:prose-invert mt-10 max-w-none prose-headings:scroll-mt-20 prose-pre:bg-slate-950">
    <h2 id="about">这是什么</h2>
    <p>
      <strong>FlipCard</strong> 是
      <a href="https://reactbits.dev" target="_blank" rel="noopener noreferrer">React Bits</a>
      组件库中的一个开源 React 组件（变体 JavaScript + CSS，依赖 <code>motion</code>）：
      一张能翻面的 3D 卡片——点击翻面、抓住拖拽手动翻、快速一甩带着角速度落回最近的面；
      悬停时卡片朝光标方向倾斜（tilt）、表面跟着光标位置走一层眩光（glare），翻到侧面时下方阴影会收窄。
      支持受控 / 非受控两种翻转状态，键盘 Enter / 空格也能翻，
      开启系统的「减少动态」偏好后自动降级为交叉淡入淡出。顶部演示用的是站内自己的图片素材。
    </p>
    <p>
      这也是站内集成的<strong>第一个带运行时依赖</strong>的 React Bits 组件：
      前几个特效要么零依赖、要么只用站内已有的 <code>ogl</code>，这次需要 <code>npm install motion</code>
      （React 生态常用的弹簧动画库，gzip 后约 50KB）。
    </p>
    <p>
      它的发布方式和前几个特效
      <a href="/demos/branched-menu/">BranchedMenu</a>、<a href="/demos/pattern-waves/">PatternWaves</a>、
      <a href="/demos/crystalized-ball/">CrystalizedBall</a>、<a href="/demos/circular-carousel/">CircularCarousel</a>
      一样：官方提供一段<strong>集成提示词（Prompt）</strong>——把组件源码、用法示例和 Props 表打包成一段结构化文本，
      交给 Claude Code、Cursor 这类 AI 编码工具，它就能自动完成落文件、渲染组件的全过程。
      下方收录这段提示词的中文翻译，专有名词保留英文原文。
    </p>

    <h2 id="usage">用法示例</h2>
    <pre><code class="language-jsx">{usageExample}</code></pre>

    <h2 id="props">Props 一览</h2>
    <table>
      <thead>
        <tr><th>属性</th><th>类型</th><th>默认值</th><th>说明</th></tr>
      </thead>
      <tbody>
        {props.map((p) => (
          <tr>
            <td><code>{p.name}</code></td>
            <td><code>{p.type}</code></td>
            <td><code>{p.def}</code></td>
            <td>{p.desc}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h2 id="steps">集成步骤</h2>
    <ol>
      <li>安装列出的依赖（本组件需要 <code>npm install motion</code>）。</li>
      <li>把组件源码复制到项目的合适目录。</li>
      <li>在引入组件的同时引入 CSS 文件。</li>
      <li>以上面的用法示例为起点导入并渲染组件。</li>
      <li>根据具体场景调整 props —— 全部可用选项见上方 Props 表。</li>
    </ol>

    <h2 id="origin">来源</h2>
    <p>
      组件与提示词来自
      <a href="https://reactbits.dev" target="_blank" rel="noopener noreferrer">reactbits.dev</a>（React Bits，MIT License），
      完整组件索引见
      <a href="https://reactbits.dev/llms.txt" target="_blank" rel="noopener noreferrer">reactbits.dev/llms.txt</a>。
    </p>

    <h2 id="prompt-zh">一键复制：完整提示词（中文）</h2>
    <p>
      下面整段就是把 <code>FlipCard</code> 装进任意项目所需的集成提示词，已翻译成中文（专有名词保留英文，附完整组件源码和 CSS）。
      点右上角「复制全文」按钮，把真实源码粘进占位符后投喂给 AI 编码工具即可复现本页效果。
    </p>
    <PromptCopyBox prompt={promptZh} />
  </article>
</BaseLayout>
