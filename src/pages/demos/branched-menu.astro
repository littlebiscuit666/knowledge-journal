---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BranchedMenuHero from '../../components/branchedmenu/BranchedMenuHero.jsx';
import PromptCopyBox from '../../components/PromptCopyBox.astro';
// 提示词全文存为 md 单一事实来源，?raw 读入供一键复制
import promptZh from '../../lib/prompts/branched-menu.zh.md?raw';

const usageExample = `import { Download04Icon, Rocket01Icon, Settings02Icon } from '@hugeicons/core-free-icons';
import BranchedMenu from './BranchedMenu';

<BranchedMenu
  items={[
    {
      label: 'Getting started',
      children: [
        { value: 'install', label: 'Installation', icon: Download04Icon },
        { value: 'quick', label: 'Quick start', icon: Rocket01Icon },
        { value: 'config', label: 'Configuration', icon: Settings02Icon }
      ]
    },
    { label: 'Components', children: [{ value: 'buttons', label: 'Buttons' }, { value: 'overlays', label: 'Overlays' }] },
    { value: 'about', label: 'About' }
  ]}
  defaultOpen={[0]}
  defaultActive="quick"
  onSelect={(value, item) => navigate(value)}
  color="#f5f5f5"
  accentColor="#f5f5f5"
  lineColor="#3f3f46"
  width={240}
  rowHeight={36}
  indent={40}
  trunk={14}
  radius={10}
  lineWidth={1.5}
  fontSize={14}
  drawDuration={400}
  foldDuration={300}
/>`;

const props = [
  { name: 'items', type: 'BranchedMenuItem[]', def: 'DEFAULT_ITEMS', desc: '区块列表：label 加 children（value、label、icon），或带 value 的叶子。带 children 的区块可折叠；叶子点击即选中。' },
  { name: 'defaultOpen', type: 'number | number[]', def: '0', desc: '初始展开的区块序号（可传数组展开多个），-1 表示全部收起。' },
  { name: 'defaultActive', type: 'string', def: "''", desc: '初始选中的值。留空则自动选中第一个已展开区块的第一个子项。' },
  { name: 'onSelect', type: '(value, item) => void', def: '-', desc: '某个子项或叶子被选中时调用。' },
  { name: 'onToggle', type: '(index, open) => void', def: '-', desc: '某个区块被折叠或展开时调用，open 表示展开后的状态。' },
  { name: 'color', type: 'string', def: "'#f5f5f5'", desc: '墨色。线条与未选中文字由它和透明混出。' },
  { name: 'accentColor', type: 'string', def: "'#f5f5f5'", desc: '强调色。选中行的分支线、选中的标题文字与左侧指示标记都用它。' },
  { name: 'lineColor', type: 'string', def: "'#3f3f46'", desc: '树轨、树干与分支的颜色。用纯色，所以线条接口处不会叠深。' },
  { name: 'width', type: 'number', def: '240', desc: '菜单允许的最大宽度（px）。实际会收缩到内容宽度。' },
  { name: 'rowHeight', type: 'number', def: '36', desc: '子项行高（px）。' },
  { name: 'indent', type: 'number', def: '40', desc: '子行文字起点（px）。分支线终点略靠前一点。' },
  { name: 'trunk', type: 'number', def: '14', desc: '树干线的 x 坐标（px）。' },
  { name: 'radius', type: 'number', def: '10', desc: '每条分支拐弯处的圆角半径（px）。' },
  { name: 'lineWidth', type: 'number', def: '1.5', desc: '线条描边宽度。' },
  { name: 'fontSize', type: 'number', def: '14', desc: '子项字号（px）。区块标题比它大 1px。' },
  { name: 'drawDuration', type: 'number', def: '400', desc: '强调线沿树干走到选中行的时间（ms）。' },
  { name: 'foldDuration', type: 'number', def: '300', desc: '区块折叠/展开的时间（ms）。' },
  { name: 'className', type: 'string', def: "''", desc: 'nav 根元素的额外类名。' },
];
---

<BaseLayout
  title="BranchedMenu 实时演示 · React Bits 集成提示词 · 每日所学"
  description="React Bits 开源组件 BranchedMenu 的实时效果演示与集成提示词中文翻译：SVG 树状分支导航菜单，展开目录分支线生长、选中项强调线滑行。"
>
  <BranchedMenuHero client:visible />

  <article class="prose prose-slate dark:prose-invert mt-10 max-w-none prose-headings:scroll-mt-20 prose-pre:bg-slate-950">
    <h2 id="about">这是什么</h2>
    <p>
      <strong>BranchedMenu</strong> 是
      <a href="https://reactbits.dev" target="_blank" rel="noopener noreferrer">React Bits</a>
      组件库中的一个开源 React 组件（变体 JavaScript + CSS，依赖
      <code>@hugeicons/react</code> 与 <code>@hugeicons/core-free-icons</code> 两个免费图标包）：
      一个书页目录式的树状导航菜单——左侧一条树轨，展开区块时 SVG 分支线带着圆角弧「长」出来，
      选中某行时一条强调线沿树干滑过去点亮它，折叠动画用 <code>grid-template-rows</code> 过渡实现，全程无 canvas。
    </p>
    <p>
      顶部演示用的菜单内容不是官方示例，而是本站的真实导航：六个分类 + 特效演示索引 + 一个叶子项，
      点选只更新状态不真跳转，右侧面板实时显示 <code>onSelect</code> / <code>onToggle</code> 回调。
      它的发布方式和前三个特效
      <a href="/demos/pattern-waves/">PatternWaves</a>、<a href="/demos/crystalized-ball/">CrystalizedBall</a>、
      <a href="/demos/circular-carousel/">CircularCarousel</a>
      一样：官方提供一段<strong>集成提示词（Prompt）</strong>——把组件源码、用法示例和 Props 表打包成一段结构化文本，
      交给 Claude Code、Cursor 这类 AI 编码工具，它就能自动完成装依赖、落文件、渲染组件的全过程。
      下方收录这段提示词的中文翻译，专有名词保留英文原文。
    </p>

    <h2 id="usage">用法示例</h2>
    <pre><code class="language-jsx">{usageExample}</code></pre>

    <h2 id="props">Props 一览</h2>
    <table>
      <thead>
        <tr><th>属性</th><th>类型</th><th>默认值</th><th>说明</th></tr>
      </thead>
      <tbody>
        {props.map((p) => (
          <tr>
            <td><code>{p.name}</code></td>
            <td><code>{p.type}</code></td>
            <td><code>{p.def}</code></td>
            <td>{p.desc}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h2 id="steps">集成步骤</h2>
    <ol>
      <li>安装列出的依赖（<code>npm i @hugeicons/react @hugeicons/core-free-icons</code>，free 图标包支持 tree-shake，只打包用到的图标）。</li>
      <li>把组件源码复制到项目的合适目录。</li>
      <li>在引入组件的同时引入 CSS 文件。</li>
      <li>以上面的用法示例为起点导入并渲染组件。</li>
      <li>根据具体场景调整 props —— 全部可用选项见上方 Props 表。</li>
    </ol>

    <h2 id="origin">来源</h2>
    <p>
      组件与提示词来自
      <a href="https://reactbits.dev" target="_blank" rel="noopener noreferrer">reactbits.dev</a>（React Bits，MIT License），
      完整组件索引见
      <a href="https://reactbits.dev/llms.txt" target="_blank" rel="noopener noreferrer">reactbits.dev/llms.txt</a>。
    </p>

    <h2 id="prompt-zh">一键复制：完整提示词（中文）</h2>
    <p>
      下面整段就是把 <code>BranchedMenu</code> 装进任意项目所需的集成提示词，已翻译成中文（专有名词保留英文，附完整 CSS）。
      点右上角「复制全文」按钮，把真实源码粘进占位符后投喂给 AI 编码工具即可复现本页效果。
    </p>
    <PromptCopyBox prompt={promptZh} />
  </article>
</BaseLayout>
