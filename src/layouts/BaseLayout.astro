---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '记录每天学到的知识' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-slate-50 font-sans text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
    <header class="sticky top-0 z-30 border-b border-slate-200 bg-slate-50/80 backdrop-blur dark:border-slate-800 dark:bg-slate-950/80">
      <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-3">
        <button
          id="menu-btn"
          class="inline-flex h-9 w-9 items-center justify-center rounded-md text-slate-500 hover:bg-slate-200 dark:text-slate-400 dark:hover:bg-slate-800 md:hidden"
          aria-label="打开目录"
          aria-controls="sidebar"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
        <a href="/" class="text-xl font-bold tracking-tight hover:text-blue-600 dark:hover:text-blue-400">
          每日所学
        </a>
        <a
          href="/rss.xml"
          class="ml-auto rounded-md px-2 py-1 text-sm text-slate-500 hover:bg-slate-200 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-100"
        >
          RSS
        </a>
      </div>
    </header>

    <div id="backdrop" class="fixed inset-0 z-40 hidden bg-black/50 md:hidden"></div>

    <div class="mx-auto flex max-w-6xl gap-8 px-4 py-6">
      <aside
        id="sidebar"
        class="fixed inset-y-0 left-0 z-50 w-72 -translate-x-full overflow-y-auto bg-slate-50 p-5 transition-transform duration-200 dark:bg-slate-950 md:static md:w-60 md:shrink-0 md:translate-x-0 md:bg-transparent md:p-0 md:dark:bg-transparent"
      >
        <Sidebar />
      </aside>
      <main class="min-w-0 flex-1">
        <slot />
      </main>
    </div>

    <footer class="border-t border-slate-200 py-6 text-center text-sm text-slate-400 dark:border-slate-800 dark:text-slate-500">
      每日所学 · 用 Astro + Vercel 搭建
    </footer>

    <script>
      const sidebar = document.getElementById('sidebar');
      const backdrop = document.getElementById('backdrop');

      function closeDrawer() {
        sidebar?.classList.add('-translate-x-full');
        backdrop?.classList.add('hidden');
      }

      document.getElementById('menu-btn')?.addEventListener('click', () => {
        sidebar?.classList.toggle('-translate-x-full');
        backdrop?.classList.toggle('hidden');
      });
      document.getElementById('menu-close')?.addEventListener('click', closeDrawer);
      backdrop?.addEventListener('click', closeDrawer);
      sidebar?.addEventListener('click', (e) => {
        if (e.target instanceof Element && e.target.closest('a')) closeDrawer();
      });
    </script>
  </body>
</html>
