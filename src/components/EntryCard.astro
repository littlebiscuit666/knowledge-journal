---
import { excerpt, formatDateShort, type Entry } from '../lib/entries';

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const summary = excerpt(entry.body);
---

<article
  class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition-shadow hover:shadow-md dark:border-slate-800 dark:bg-slate-900"
>
  <div class="mb-1.5 flex items-center gap-2">
    <span
      class="rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-medium text-blue-700 dark:bg-blue-950 dark:text-blue-300"
    >
      {entry.data.category}
    </span>
    <span class="text-xs text-slate-400 dark:text-slate-500">{formatDateShort(entry.data.date)}</span>
    {
      entry.data.tags.length > 0 && (
        <span class="ml-auto flex gap-1.5">
          {entry.data.tags.map((tag) => (
            <span class="rounded bg-slate-100 px-2 py-0.5 text-xs text-slate-500 dark:bg-slate-800 dark:text-slate-400">
              #{tag}
            </span>
          ))}
        </span>
      )
    }
  </div>
  <a href={`/entries/${entry.id}/`} class="block">
    <h3 class="font-semibold leading-snug transition-colors group-hover:text-blue-600 dark:group-hover:text-blue-400">
      {entry.data.title}
    </h3>
    <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-slate-500 dark:text-slate-400">
      {summary}
    </p>
  </a>
</article>
